# 复制为 .env.local 后填入实际值

# ─── AI 推理（支持 DeepSeek / Anthropic / MiMo / OpenAI 兼容）───
# 仅排盘时可不填 AI 与付费配置；启用 /api/interpret 与 /api/heming 时按需填写。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ─── Anthropic Claude ───
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── 或用其他 OpenAI 兼容模型（MiMo / 通用 OpenAI 协议）───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# AI_PROVIDER=openai-compatible
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://your-openai-compatible-provider/v1
# OPENAI_MODEL=gpt-4o-mini

# ─── 付费守卫与访问令牌（默认 strict，切到 off 仅限本地开发）───
AI_PAYWALL_MODE=strict
ACCESS_TOKEN_SECRET=replace-with-32-byte-random-access-secret
PAYWALL_WEBHOOK_SECRET=replace-with-32-byte-random-webhook-secret

# ─── 数据持久化与分布式缓存 / 限流（可选，未配置时测试与本地可降级内存模式）───
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ziwei
REDIS_URL=redis://localhost:6379
# INTERPRET_RATE_LIMIT_PER_MIN=20
# CHART_RATE_LIMIT_PER_MIN=60

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
